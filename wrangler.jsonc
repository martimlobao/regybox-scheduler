{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regybox-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "REGYBOX_STATE",
      "id": "15757eea68bf4d889c287732843a7c2b"
    }
  ],
  "triggers": {
    "crons": [
      "28,58 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKR_COORDINATOR",
        "class_name": "BookrCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-bookr-coordinator",
      "new_sqlite_classes": [
        "BookrCoordinator"
      ]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "send_email": [
    {
      "name": "EMAIL_SENDER"
    }
  ]
}
