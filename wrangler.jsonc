{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regybox-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "REGYBOX_STATE",
      "id": "15757eea68bf4d889c287732843a7c2b"
    }
  ],
  "triggers": {
    "crons": [
      "28,58 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
